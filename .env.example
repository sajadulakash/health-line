# Copy this file to `.env` and fill in your values:  cp .env.example .env

# ── Backend (FastAPI / pydantic-settings) ──
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5433/healthline
ASYNC_DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5433/healthline

# ── Frontend (Vite) ── only VITE_-prefixed vars reach the browser.
# Backend host (no trailing slash, no /api suffix — the app appends /api).
VITE_API_URL=http://192.168.68.64:8765
